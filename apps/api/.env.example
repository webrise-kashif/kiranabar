# Application environment: development | test | production
NODE_ENV=development

# HTTP server
PORT=3000

# Comma-separated list of allowed browser origins (Web Store, Admin Portal).
# The future React Native app is not a browser client and isn't subject to CORS.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# PostgreSQL connection string used by Prisma. Matches docker-compose.yml at
# the repo root -- run `docker compose up -d` before `pnpm prisma:migrate`.
DATABASE_URL="postgresql://kiranabar:kiranabar@localhost:5432/kiranabar?schema=public"

# --- Auth -------------------------------------------------------------------
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Access and refresh secrets MUST be different -- a leaked access-token
# secret must not also compromise refresh tokens. Never commit real values.
AUTH_JWT_ACCESS_SECRET=
AUTH_JWT_REFRESH_SECRET=
AUTH_JWT_ACCESS_TTL=15m
AUTH_JWT_REFRESH_TTL=30d

# --- Storage (placeholders) -------------------------------------------------
# Not consumed anywhere yet -- for future product image / file uploads.
# STORAGE_PROVIDER=local requires no other STORAGE_* value.
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
